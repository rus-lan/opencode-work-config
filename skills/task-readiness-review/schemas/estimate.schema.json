{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Оценка задачи",
  "description": "Артефакт прогона estimate.json: числа по ролям и итог. roles отсортированы по role, scenarios — ровно три в порядке base, optimistic, pessimistic. У каждой роли непустой provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_key",
    "estimated_at",
    "model_version",
    "model_checksum",
    "roles",
    "total",
    "variability_reason",
    "blocked_by_gaps"
  ],
  "properties": {
    "task_key": {
      "type": "string",
      "pattern": "\\S",
      "description": "Ключ задачи Jira как есть."
    },
    "estimated_at": {
      "type": "string",
      "pattern": "\\S",
      "description": "Момент расчёта оценки в UTC."
    },
    "model_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Версия модели, по которой считали."
    },
    "model_checksum": {
      "type": "string",
      "pattern": "\\S",
      "description": "Контрольная сумма модели, по которой считали."
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "description": "Оценки по ролям, для которых есть работа; отсортированы по role.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "expected",
          "range",
          "scenarios",
          "confidence",
          "provenance"
        ],
        "properties": {
          "role": {
            "enum": [
              "BA",
              "SA",
              "BE",
              "FE",
              "QA",
              "DEVOPS",
              "OTHER"
            ],
            "description": "Роль."
          },
          "expected": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              5,
              8,
              13,
              21
            ],
            "description": "Ожидаемое значение в шкале Story Points."
          },
          "range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "description": "Диапазон [нижняя, верхняя] граница.",
            "items": {
              "type": "integer",
              "enum": [
                1,
                2,
                3,
                5,
                8,
                13,
                21
              ]
            }
          },
          "scenarios": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "description": "Ровно три сценария в порядке base, optimistic, pessimistic.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "points",
                "reason"
              ],
              "properties": {
                "name": {
                  "enum": [
                    "base",
                    "optimistic",
                    "pessimistic"
                  ],
                  "description": "Имя сценария."
                },
                "points": {
                  "type": "integer",
                  "enum": [
                    1,
                    2,
                    3,
                    5,
                    8,
                    13,
                    21
                  ],
                  "description": "Оценка сценария в шкале Story Points."
                },
                "reason": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Почему получилось именно это число."
                }
              }
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "Уверенность в оценке роли."
          },
          "source": {
            "enum": [
              "jira",
              "model",
              "derived",
              "assumed"
            ],
            "description": "Откуда взято число роли. Необязательное поле: сейчас заполняется только у записи QA — jira (значение поля QA Estimation как есть), derived (расчёт модели по QA-бакету или доля от dev), model (QA и есть оцениваемая роль задачи)."
          },
          "qa_bucket": {
            "type": "string",
            "pattern": "\\S",
            "description": "Бакет, по которому посчитана QA-оценка (QA/issue_type/work_kind). Только у записи role=QA с source=derived."
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "description": "Провенанс чисел роли: минимум одна запись.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "kind",
                "source",
                "detail"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Поле роли, к которому относится запись: expected, range, scenarios."
                },
                "kind": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Тип источника провенанса: model, reference, sprint_stats, rule."
                },
                "source": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Идентификатор источника, например estimation-model:3:BE/Задача/implementation."
                },
                "ref": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Идентификатор правила, если запись — правило, а не бакет модели (например RS-01 — надбавка за дополнительные ресурсы)."
                },
                "value": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Короткая формулировка вклада правила (например «+2 SP за ресурсы: allure, e2e»)."
                },
                "detail": {
                  "type": "string",
                  "pattern": "\\S",
                  "description": "Пояснение расчёта."
                }
              }
            }
          }
        }
      }
    },
    "total": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "range"
      ],
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 0,
          "description": "Сумма roles[].expected, включая запись QA."
        },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "Сумма нижних и сумма верхних границ ролей, включая QA.",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected",
            "source"
          ],
          "description": "QA-составляющая итога: появляется, когда в roles[] есть запись QA. Отчёт печатает по ней строку «Dev: N SP · QA: M SP».",
          "properties": {
            "expected": {
              "type": "integer",
              "minimum": 0,
              "description": "QA-слагаемое total.expected."
            },
            "source": {
              "enum": [
                "jira",
                "model",
                "derived",
                "assumed"
              ],
              "description": "Откуда взято QA-число: jira, derived (модель) или model (QA — оцениваемая роль)."
            },
            "bucket": {
              "type": "string",
              "pattern": "\\S",
              "description": "Бакет QA-оценки (QA/issue_type/work_kind); отсутствует, когда число взято из Jira."
            }
          }
        }
      }
    },
    "role_assumed": {
      "type": "boolean",
      "description": "Роль в снимке не указана, и оценена доминирующая роль вида работ (бакет с максимальным n, n desc → role asc). Поле опционально: появляется только в этом случае. Подробности — в variability_reason[] и provenance роли (source=estimate:role-assumed)."
    },
    "qa_scope": {
      "type": "string",
      "description": "Почему в оценке нет QA-записи: тип задачи не требует QA-оценки, проверку результата выполняет исполнитель. Пример: «не требуется (тип «Tech Debt») — проверка результата входит в объём роли FE». Поле опционально: появляется только когда QA-записи нет, но тип задачи и роль исполнителя известны."
    },
    "similar_tasks": {
      "type": "array",
      "minItems": 0,
      "description": "Похожие задачи корпуса (справочно, этап A векторизации): top-N по косинусу текстов. Поле опционально и появляется только при estimation.vector.enabled: true. На expected/range не влияет, если adjust_range: false.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "cosine",
          "sp",
          "role",
          "work_kind",
          "same_bucket"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "\\S",
            "description": "Ключ похожей задачи."
          },
          "cosine": {
            "type": "number",
            "minimum": 0,
            "description": "Косинус текстов: похожесть по словам, не вероятность."
          },
          "sp": {
            "type": [
              "number",
              "null"
            ],
            "description": "Story Points соседа: число или null."
          },
          "role": {
            "enum": [
              "BA",
              "SA",
              "BE",
              "FE",
              "QA",
              "DEVOPS",
              "OTHER"
            ],
            "description": "Роль соседа."
          },
          "work_kind": {
            "enum": [
              "implementation",
              "research",
              "bugfix",
              "tech_debt",
              "analysis",
              "testing",
              "unknown"
            ],
            "description": "Вид работ соседа."
          },
          "same_bucket": {
            "type": "boolean",
            "description": "Совпадает ли бакет (role, work_kind) соседа с бакетом задачи."
          }
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "description": "Эвристические параметры задачи и применённый множитель. Поле необязательно: старые оценки без него остаются валидными. Множитель считается относительно baseline (профиль бакета или defaults) и применён к expected и range до штрафов за пробелы.",
      "required": [
        "weight",
        "heat",
        "connectivity",
        "source",
        "multiplier",
        "baseline",
        "baseline_source",
        "applied"
      ],
      "properties": {
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Вес задачи (сложность и объём), 0.0…1.0."
        },
        "heat": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Необходимость проработки, 0.0…1.0."
        },
        "connectivity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Связанность и внешние интеграции, 0.0…1.0."
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "description": "Откуда взято значение параметра: heuristic — из сигналов снимка, override — ручное число, disabled — estimation.params.enabled=false.",
          "required": [
            "weight",
            "heat",
            "connectivity"
          ],
          "properties": {
            "weight": {
              "type": "string",
              "pattern": "\\S"
            },
            "heat": {
              "type": "string",
              "pattern": "\\S"
            },
            "connectivity": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "evidence": {
          "type": "array",
          "description": "Строки провенанса сигналов: какой сигнал дал какой вклад.",
          "items": {
            "type": "string"
          }
        },
        "multiplier": {
          "type": "number",
          "minimum": 0,
          "description": "Множитель к expected/range после зажима в estimation.params.clamp."
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "description": "Значения параметров, при которых множитель равен 1.0.",
          "required": [
            "weight",
            "heat",
            "connectivity"
          ],
          "properties": {
            "weight": {
              "type": "number"
            },
            "heat": {
              "type": "number"
            },
            "connectivity": {
              "type": "number"
            }
          }
        },
        "baseline_source": {
          "enum": [
            "bucket",
            "defaults"
          ],
          "description": "bucket — baseline из params_profile бакета модели; defaults — из estimation.params.defaults."
        },
        "applied": {
          "type": "boolean",
          "description": "Участвовал ли множитель в расчёте (false при estimation.params.enabled=false)."
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "description": "Надбавка за дополнительные ресурсы задачи (правило RS-01): allure для тест-кейсов, e2e-сервис автотестирования для автотестов. Поле необязательно: появляется только когда ресурсы распознаны в снимке задачи (как qa_scope). Надбавка применена к записи основного исполнителя (applied_to), производная QA-запись не затрагивается — иначе двойной счёт.",
      "required": [
        "items",
        "count",
        "sp_per_resource",
        "bonus_sp",
        "mode",
        "applied_to",
        "effect"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "description": "Распознанные ресурсы, отсортированы по name.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "evidence",
              "source"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "\\S",
                "description": "Имя ресурса из каталога estimation.resources.items (allure, e2e, …)."
              },
              "evidence": {
                "type": "string",
                "pattern": "\\S",
                "description": "Короткая цитата из снимка задачи, где ресурс упомянут (≤ 120 символов)."
              },
              "source": {
                "type": "string",
                "pattern": "^(summary|description|issue_type|labels|sections\\.[A-Za-z0-9_.-]+)$",
                "description": "Поле снимка, где нашлось упоминание: summary, description, issue_type, labels или sections.<ключ>."
              }
            }
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Сколько ресурсов распознано."
        },
        "sp_per_resource": {
          "type": "number",
          "minimum": 0,
          "description": "Надбавка за один ресурс (estimation.resources.sp_per_resource)."
        },
        "bonus_sp": {
          "type": "number",
          "minimum": 0,
          "description": "Суммарная надбавка: count × sp_per_resource. При mode=upper_bound шаг не прибавляется (берётся верхняя граница), поэтому здесь 0."
        },
        "mode": {
          "enum": [
            "add",
            "upper_bound"
          ],
          "description": "add — надбавка прибавлена к expected; upper_bound — expected взят по верхней границе диапазона."
        },
        "applied_to": {
          "type": "string",
          "pattern": "\\S",
          "description": "Роль, к записи которой применена надбавка (основной исполнитель)."
        },
        "effect": {
          "type": "string",
          "pattern": "\\S",
          "description": "Эффект надбавки словами: «expected 1 → 3 SP»."
        }
      }
    },
    "variability_reason": {
      "type": "array",
      "description": "Словами: почему оценка вариативна.",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "blocked_by_gaps": {
      "type": "array",
      "description": "Идентификаторы REQUIRED-пробелов, повлиявших на оценку.",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": true,
      "description": "Копия содержательного анализа из validation.json (analysis.analyze): понятность, измеримость, сценарии, область, связи. Необязательное поле — оценка без анализа остаётся валидной."
    }
  }
}
