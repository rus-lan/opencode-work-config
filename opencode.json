{
  "$schema": "https://opencode.ai/config.json",
  "model": "ecom/deepseek-v4-flash",
  "small_model": "ecom/qwen3.8-27b",
  "default_agent": "orchestrator",
  "subagent_depth": 4,
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "skill": "allow",
    "edit": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow",
      "~/public/*": "allow",
      "~/slo-kit/*": "allow",
      "~/workspaces/*": "allow",
      "/etc/*": "allow"
    },
    "bash": {
      "npm run *": "allow",
      "npm t": "allow",
      "git status*": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git diff *": "allow",
      "rg *": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "jq *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "list *": "allow",
      "glob *": "allow",
      "echo *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "/tmp*": "allow",
      "rm -rf *": "deny",
      "rm *": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "*": "allow"
    },
    "webfetch": "allow",
    "doom_loop": "ask",
    "atlassian_jira_*": "ask",
    "atlassian_jira_get_*": "allow",
    "atlassian_jira_search*": "allow",
    "atlassian_confluence_*": "ask",
    "atlassian_confluence_get_*": "allow",
    "atlassian_confluence_search*": "allow",
    "gitlab_*": "ask",
    "gitlab_getFile": "allow",
    "gitlab_listTree": "allow",
    "gitlab_searchCode": "allow",
    "gitlab_getIssue": "allow"
  },
  "provider": {
    "ecom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ecom",
      "options": {
        "baseURL": "https://llm-core-olap.samokat.ru/v1",
        "apiKey": "{env:ECOM_LLM_TOKEN}",
        "setCacheKey": true
      },
      "models": {
        "qwen3.8-27b": {
          "name": "qwen3.8-27b",
          "limit": {
            "context": 256000,
            "output": 16384
          },
          "options": { "reasoningEffort": "xhigh" }
        },
        "qwen3.8-27b-no-think": {
          "name": "qwen3.8-27b-no-think",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "limit": {
            "context": 256000,
            "output": 16384
          },
          "options": { "reasoningEffort": "xhigh" }
        }
      }
    },
    "ecom-exp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ecom-exp",
      "options": {
        "baseURL": "https://llm-core-olap.samokat.ru/v1",
        "apiKey": "{env:ECOM_LLM_EXP_TOKEN}",
        "setCacheKey": true
      },
      "models": {
        "glm-5.3-flash": {
          "name": "glm-5.3-flash",
          "limit": {
            "context": 256000,
            "output": 16384
          }
        }
      }
    }
  },
  "mcp": {
    "aistats": {
      "type": "local",
      "command": [
        "aistats",
        "mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--executable-path",
        "/home/ruslan/.cache/ms-playwright/chromium-1243/chrome-linux64/chrome",
        "--headless",
        "--no-sandbox",
        "--isolated"
      ],
      "environment": {
        "HOME": "/home/ruslan",
        "PLAYWRIGHT_HOST_PLATFORM_OVERRIDE": "ubuntu24.04-x64"
      },
      "enabled": true
    },
    "confluence_samokat_read_only": {
      "type": "remote",
      "url": "https://llm-core-olap.samokat.ru/Confluence_Samokat_Read_Only/mcp",
      "enabled": true,
      "headers": {
        "x-litellm-api-key": "Bearer {env:ECOM_LLM_TOKEN}",
        "Authorization": "Bearer {env:CONFLUENCE_TOKEN}"
      }
    },
    "jira_samokat_read_only": {
      "type": "remote",
      "url": "https://llm-core-olap.samokat.ru/Jira_Samokat_Read_Only/mcp",
      "enabled": true,
      "headers": {
        "x-litellm-api-key": "Bearer {env:ECOM_LLM_TOKEN}",
        "Authorization": "Bearer {env:JIRA_TOKEN}"
      }
    },
    "confluence_samokat_write": {
      "type": "remote",
      "url": "https://llm-core-olap.samokat.ru/Confluence_Samokat_Write/mcp",
      "enabled": true,
      "headers": {
        "x-litellm-api-key": "Bearer {env:ECOM_LLM_TOKEN}",
        "Authorization": "Bearer {env:CONFLUENCE_TOKEN}"
      }
    },
    "jira_samokat_write": {
      "type": "remote",
      "url": "https://llm-core-olap.samokat.ru/Jira_Samokat_Write/mcp",
      "enabled": true,
      "headers": {
        "x-litellm-api-key": "Bearer {env:ECOM_LLM_TOKEN}",
        "Authorization": "Bearer {env:JIRA_TOKEN}"
      }
    },
    "public_adr_c4_drawio": {
      "type": "remote",
      "url": "https://litellm-proxy-llm-core-olap.samokat.io/public_adr_c4_drawio/mcp",
      "enabled": true,
      "headers": {
        "x-litellm-api-key": "Bearer {env:ECOM_LLM_TOKEN}"
      }
    },
    "testops": {
      "type": "remote",
      "enabled": true,
      "url": "https://allure-testops-mcp-pqa.ecom.tech/api/mcp",
      "headers": {
        "Authorization": "Bearer {env:ALLURE_TOKEN}"
      },
      "oauth": false,
      "timeout": 30000
    },
    "gitlab": {
      "type": "remote",
      "enabled": true,
      "url": "https://llm-core-olap.samokat.ru/gitecomrooir/mcp",
      "headers": {
        "x-litellm-api-key": "Bearer {env:ECOM_LLM_TOKEN}",
        "Authorization": "Bearer {env:GITLAB_TOKEN}"
      },
      "oauth": false,
      "timeout": 30000
    }
  },
  "instructions": [
    "rules/*.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      ".bmad/**",
      ".research/**",
      "*.log",
      "dist/**",
      ".next/**",
      ".cache/**"
    ]
  },
  "compaction": {
    "auto": true,
    "reserved": 8000,
    "tail_turns": 3,
    "prune": true
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  }
}
