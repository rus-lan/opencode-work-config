{
  "$schema": "https://opencode.ai/config.json",

  "model": "ecom-qwen35-122b/qwen3.5-122b",

  "permission": {
    "bash": "allow",
    "edit": "allow"
  },

  "provider": {

    "ecom-qwen35-122b": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "qwen3.5-122b",
      "options": {
        "baseURL": "https://llm-core-olap.samokat.ru/v1",
        "apiKey": "{env:ECOM_QWEN35_122b_TOKEN}"
      },
      "models": {
        "qwen3.5-122b": {
          "name": "qwen3.5-122b",
          "description": "QWEN 3.5 122B (локальный)"
        }
      }
    },

    "ecom-qwen36-35b": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "qwen3.6-35b",
      "options": {
        "baseURL": "https://llm-core-olap.samokat.ru/v1",
        "apiKey": "{env:ECOM_QWEN36_35b_TOKEN}"
      },
      "models": {
        "qwen3.6-35b": {
          "name": "qwen3.6-35b",
          "description": "QWEN 3.6 35B (локальный)"
        }
      }
    },

    "ecom-deepseek4-flash-max": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "deepseek-v4-flash:max",
      "options": {
        "baseURL": "https://llm-core-olap.samokat.ru/v1",
        "apiKey": "{env:ECOM_DEEPSEEL4_FLASH_MAX_TOKEN}"
      },
      "models": {
        "deepseek-v4-flash:max": {
          "name": "deepseek-v4-flash:max",
          "description": "Deepseek v4 flash (max)"
        }
      }
    },

    "ecom-qwen35-122b-no-think": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "qwen3.5-122b-no-think",
      "options": {
        "baseURL": "https://llm-core-olap.samokat.ru/v1",
        "apiKey": "{env:ECOM_QWEN35_122b_NO_THINK_TOKEN}"
      },
      "models": {
        "qwen3.5-122b-no-think": {
          "name": "qwen3.5-122b-no-think",
          "description": "QWEN 3.5 122B no think (локальный)"
        }
      }
    },

    "ecom-qwen36-35b-no-think": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "qwen3.6-35b-no-think",
      "options": {
        "baseURL": "https://llm-core-olap.samokat.ru/v1",
        "apiKey": "{env:ECOM_QWEN36_35b_NO_THINK_TOKEN}"
      },
      "models": {
        "qwen3.6-35b-no-think": {
          "name": "qwen3.6-35b-no-think",
          "description": "QWEN 3.6 35B no think (локальный)"
        }
      }
    },

    "ecom-deepseek4-flash": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "deepseek-v4-flash",
      "options": {
        "baseURL": "https://llm-core-olap.samokat.ru/v1",
        "apiKey": "{env:ECOM_DEEPSEEL4_FLASH_TOKEN}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "description": "Deepseek v4 flash"
        }
      }
    },

    "ecom-giga3-10b": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "giga3-10b",
      "options": {
        "baseURL": "https://llm-core-olap.samokat.ru/v1",
        "apiKey": "{env:ECOM_GIGA3_10b_TOKEN}"
      },
      "models": {
        "giga3-10b": {
          "name": "giga3-10b",
          "description": "Giga v3 10B"
        }
      }
    }
  },

  "mcp": {
    "aistats": {
      "type": "local",
      "command": [
        "aistats",
        "mcp"
      ],
      "enabled": true
    }
  },

  "skills": {
    "enabled": [
      "caveman",
      "grill-me",
      "config-pull",
      "project-pull",
      "project-push",
      "desearch",
      "workspace-init",
      "design",
      "graphify",
      "mapps"
    ]
  },

  "workflow": {
    "maxParallelAgents": 3,
    "reviewGate": {
      "enabled": true,
      "threshold": ["feature", "refactor", "bugfix-critical"],
      "skipThreshold": ["docs", "test", "chore", "rename"]
    },
    "timeouts": {
      "desearch-researcher": 300000,
      "desearch-synthesizer": 180000,
      "dev-agents": 600000,
      "reviewer": 180000,
      "explore": 60000
    }
  }
}
