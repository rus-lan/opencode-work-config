{
  "$schema": "https://opencode.ai/config.json",
  "model": "ecom/deepseek-v4-flash",
  "small_model": "ecom/qwen3.8-27b",
  "default_agent": "orchestrator",
  "subagent_depth": 2,
  "permission": {
    "bash": "allow",
    "edit": "allow"
  },
  "provider": {
    "ecom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ecom",
      "options": {
        "baseURL": "https://llm-core-olap.samokat.ru/v1",
        "apiKey": "{env:ECOM_LLM_TOKEN}",
        "setCacheKey": true
      },
      "models": {
        "giga3-10b": {
          "name": "giga3-10b",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "qwen3.8-27b": {
          "name": "qwen3.8-27b",
          "limit": {
            "context": 256000,
            "output": 16384
          }
        },
        "qwen3.6-35b": {
          "name": "qwen3.6-35b",
          "limit": {
            "context": 256000,
            "output": 16384
          }
        },
        "qwen3.5-122b-no-think": {
          "name": "qwen3.5-122b-no-think",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "qwen3.5-122b": {
          "name": "qwen3.5-122b",
          "limit": {
            "context": 256000,
            "output": 16384
          }
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "limit": {
            "context": 256000,
            "output": 16384
          }
        }
      }
    },
    "ecom-exp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ecom-exp",
      "options": {
        "baseURL": "https://llm-core-olap.samokat.ru/v1",
        "apiKey": "{env:ECOM_LLM_EXP_TOKEN}",
        "setCacheKey": true
      },
      "models": {
        "glm-5.2": {
          "name": "glm-5.2",
          "limit": {
            "context": 256000,
            "output": 16384
          }
        }
      }
    },
    "zai-coding-plan": {
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM-5.2",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    }
  },
  "mcp": {
    "aistats": {
      "type": "local",
      "command": [
        "aistats",
        "mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--executable-path",
        "${HOME}/.cache/ms-playwright/chromium-1234/chrome-linux64/chrome",
        "--headless",
        "--no-sandbox",
        "--isolated"
      ],
      "environment": {
        "PLAYWRIGHT_HOST_PLATFORM_OVERRIDE": "ubuntu24.04-x64"
      },
      "enabled": true
    }
  },
  "instructions": [
    "rules/*.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      ".bmad/**",
      ".research/**",
      "*.log",
      "dist/**",
      ".next/**",
      ".cache/**"
    ]
  },
  "compaction": {
    "auto": true,
    "reserved": 8000,
    "tail_turns": 3,
    "prune": true
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  }
}
